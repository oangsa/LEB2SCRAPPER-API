{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OutboundRequestGate": {
    "MaxConcurrentRequests": 4,
    "BaseBackoffSeconds": 30,
    "MaxBackoffMinutes": 5,
    "FailureResetMinutes": 15,
    "StructuralFailureThreshold": 3,
    "StructuralFailureWindowMinutes": 15
  },
  "FailureAlerts": {
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "ToAddress": "",
      "DeliveryTimeoutSeconds": 30
    }
  },
  "AllowedHosts": "*"
}
