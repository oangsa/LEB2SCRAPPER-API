{
  "ConnectionStrings": {
    "Supabase": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OutboundRequestGate": {
    "MaxConcurrentRequests": 4,
    "MaxConcurrentRequestsPerClient": 2,
    "MaxQueuedRequestsPerClient": 8,
    "ClientThrottleRetryAfterSeconds": 1,
    "BaseBackoffSeconds": 30,
    "MaxBackoffMinutes": 5,
    "FailureResetMinutes": 15,
    "StructuralFailureThreshold": 3,
    "StructuralFailureWindowMinutes": 15
  },
  "StructuralScrapeCache": {
    "AbsoluteTtlSeconds": 60,
    "MaximumEntries": 10000
  },
  "ActivityResultCache": {
    "AbsoluteTtlSeconds": 30,
    "MaximumEntries": 2000
  },
  "FailureAlerts": {
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "ToAddress": "",
      "DeliveryTimeoutSeconds": 30
    }
  },
  "AllowedHosts": "*"
}
